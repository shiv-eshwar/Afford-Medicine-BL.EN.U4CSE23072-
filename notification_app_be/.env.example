# Backend service configuration
PORT=4000
NODE_ENV=development

# Upstream evaluation service
EVAL_BASE_URL=http://20.207.122.201/evaluation-service

# Registration / auth credentials
# - On first run, if CLIENT_ID/CLIENT_SECRET are missing, the service calls
#   /register using ACCESS_CODE + the profile fields below, then caches the
#   returned credentials to .credentials.json (ignored by git).
# - Subsequent runs reuse .credentials.json and skip /register.
ACCESS_CODE=PTBMmQ
EMAIL=
NAME=
MOBILE_NO=
GITHUB_USERNAME=
ROLL_NO=

# Optional — populate manually if you've already registered
CLIENT_ID=
CLIENT_SECRET=

# CORS allow-list for the frontend
ALLOWED_ORIGINS=http://localhost:3000
